# ---------------------------------------------------------------------------
# restaurant-portal environment
# ---------------------------------------------------------------------------

# Leave DATABASE_URL unset for LOCAL DEVELOPMENT. The app then uses a
# file-backed SQLite database at data/tableorder.db (better-sqlite3, writable,
# synchronous). Just run `pnpm db:setup` once, then `pnpm dev`.
#
#DATABASE_URL=

# For PRODUCTION on Vercel (read-only, serverless) point DATABASE_URL at a
# hosted libSQL/Turso database. Set this in the Vercel project dashboard:
#   Project Settings -> Environment Variables -> DATABASE_URL
#   (value looks like:  libsql://your-db-owner.turso.io)
#
# Vercel notes:
#   - Better-sqlite3 is NOT used in production — Vercel's filesystem is
#     read-only and ephemeral, so a local file DB can't persist.
#   - With DATABASE_URL set, the app uses @libsql/client over the network and
#     reads/writes are persisted remotely. Create a free Turso DB and run
#     `pnpm db:setup` against it to apply migrations + seed demo data.
#   - Leave DATABASE_URL unset for a demo deploy: the site will build and load,
#     but shows "No data — run pnpm db:setup" until a DB is configured.

# OPTIONAL: The Turso database auth token (required for some hosted plans).
# Grab it from the Turso dashboard (Settings -> Database tokens). When using a
# public/read-only URL token it may not be needed for reads, but is required to
# run migrations and seed from your machine.
#
#DATABASE_AUTH_TOKEN=